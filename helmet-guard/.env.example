# Helmet Guard 环境变量示例
# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 排除，绝不要提交。

# 运行模式：demo（合成种子数据）| live（真实点位采集）
HELMET_GUARD_MODE=demo

# 显式指定 SQLite 路径；留空则按模式推导
# HELMET_GUARD_DB=data/helmet_demo.db

# 采集进程权重路径（相对项目根目录）
HELMET_GUARD_WEIGHTS=runs/detect/helmet-v2-baseline/weights/best.pt

# 自查模型权重路径；留空则按候选顺序自动查找
# HELMET_GUARD_SELFCHECK_WEIGHTS=runs/detect/helmet-v2-baseline/weights/best.pt

# 现场提醒开关：0 静默（默认）| 1 开启
HELMET_GUARD_ALERTS_ENABLED=0

# 心跳过期秒数（超过则采集视为离线）
HELMET_GUARD_HEARTBEAT_EXPIRE=30
