# Helmet Guard 环境变量示例
# 复制为 .env 后按实际环境填写；.env 已被 .gitignore 排除，绝不要提交。

# ---------------------------------------------------------------------------
# App：应用运行模式与日志
# ---------------------------------------------------------------------------

# 应用环境：demo（本地演示）| test（自动化测试）| live（生产）
APP_ENV=demo

# 调试开关：0 关闭 | 1 开启（生产环境禁止开启）
APP_DEBUG=0

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志格式：json（生产）| console（本地开发）
LOG_FORMAT=json

# ---------------------------------------------------------------------------
# Database：数据库连接
# ---------------------------------------------------------------------------

# 显式数据库 URL；留空则按 HELMET_GUARD_MODE / HELMET_GUARD_DB 推导 SQLite 路径
# 示例：sqlite:///data/helmet_demo.db
# MySQL 示例（小皮 phpStudy，库名 helmet_guard，先用 Navicat 导入 Sql/helmet_guard_mysql.sql 建库）：
# DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/helmet_guard?charset=utf8mb4
DATABASE_URL=

# 运行模式：demo（合成种子数据）| live（真实点位采集）
HELMET_GUARD_MODE=demo

# 显式指定 SQLite 路径；留空则按模式推导
# HELMET_GUARD_DB=data/helmet_demo.db

# 采集进程权重路径（相对项目根目录）
HELMET_GUARD_WEIGHTS=runs/detect/helmet-v2-baseline/weights/best.pt

# 自查模型权重路径；留空则按候选顺序自动查找
# HELMET_GUARD_SELFCHECK_WEIGHTS=runs/detect/helmet-v2-baseline/weights/best.pt

# 心跳过期秒数（超过则采集视为离线）
HELMET_GUARD_HEARTBEAT_EXPIRE=30

# 现场提醒开关：0 静默（默认）| 1 开启
HELMET_GUARD_ALERTS_ENABLED=0

# ---------------------------------------------------------------------------
# Redis：缓存、队列与共享状态
# ---------------------------------------------------------------------------

# Redis 连接地址
REDIS_URL=redis://127.0.0.1:6379/0

# ---------------------------------------------------------------------------
# JWT：访问令牌与刷新令牌
# ---------------------------------------------------------------------------

# 令牌签名密钥；生产必须替换为高强度随机值（禁止使用示例值）
JWT_SECRET=

# 签名算法
JWT_ALGORITHM=HS256

# 访问令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=120

# 刷新令牌有效期（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# CORS：跨域白名单
# ---------------------------------------------------------------------------

# 允许的前端来源，逗号分隔；留空表示不开放跨域
CORS_ORIGINS=http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Storage：MinIO 对象存储（证据图片 / 视频）
# ---------------------------------------------------------------------------

# MinIO 服务地址
MINIO_ENDPOINT=

# MinIO 访问密钥
MINIO_ACCESS_KEY=

# MinIO 私有密钥
MINIO_SECRET_KEY=

# 证据存储桶名
MINIO_BUCKET=helmet-evidence

# ---------------------------------------------------------------------------
# WeChat：小程序登录（未配置走 Mock，不调微信接口；生产必须配置）
# ---------------------------------------------------------------------------

# 小程序 AppID（与 miniprogram/src/manifest.json → mp-weixin.appid 保持一致）
WECHAT_APPID=

# 小程序 AppSecret（只能走环境变量 / .env，禁止提交到仓库）
WECHAT_SECRET=

# ---------------------------------------------------------------------------
# LLM：话术生成（可选，失败自动回退模板）
# 总开关：0 默认走本地模板 | 1 允许在三件套齐备时调用 LLM（仅做解释）
LLM_ENABLED=0

# LLM API Key
LLM_API_KEY=

# LLM 接口地址
LLM_BASE_URL=

# LLM 模型名称
LLM_MODEL=
