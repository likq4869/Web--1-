# ===========================================================================
# 环境变量示例 —— 复制为 .env.local 后按需修改
# .env.local 已在 .gitignore 中，不会提交
# ===========================================================================

# API 基础路径（留空则走 Vite 开发代理 /api）
VITE_API_BASE_URL=/api

# 开发代理的后端地址
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# 应用标题（浏览器标签页）
VITE_APP_TITLE=校园头盔检测提醒助手
